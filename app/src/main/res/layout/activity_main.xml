<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:background="#FAF8FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        tools:ignore="WebViewLayout">

        <!-- Título principal -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ejemplo de componentes\nAndroid"
            android:textColor="#1D1B20"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Subtítulo 1 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Componentes para mostrar información"
            android:textColor="#1D1B20"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- TextView descriptivo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Este texto se muestra mediante un TextView."
            android:textColor="#49454F"
            android:textSize="14sp" />

        <!-- ImageView (Logo Android por defecto) -->
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:src="@mipmap/ic_launcher_round" />

        <!-- Etiqueta Progreso -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Progreso: 50%"
            android:textColor="#49454F"
            android:textSize="14sp" />

        <!-- ProgressBar horizontal -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progress="50"
            android:progressTint="#6750A4" />

        <!-- Etiqueta VideoView -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="VideoView"
            android:textColor="#1D1B20"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- VideoView -->
        <VideoView
            android:id="@+id/videoView"
            android:layout_width="115dp"
            android:layout_height="200dp"
            android:layout_marginTop="8dp" />

        <!-- Etiqueta WebView -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="WebView"
            android:textColor="#1D1B20"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- WebView -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="8dp" />

        <!-- Subtítulo 2 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Componentes de entrada e interacción"
            android:textColor="#1D1B20"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- EditText -->
        <EditText
            android:id="@+id/editTextNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Introduce tu nombre"
            android:inputType="textPersonName"
            android:textSize="15sp" />

        <!-- Grupo CheckBox -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Selecciona tecnologías:"
            android:textColor="#1D1B20"
            android:textSize="14sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbAndroid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Android" />

        <CheckBox
            android:id="@+id/cbReact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="React" />

        <CheckBox
            android:id="@+id/cbFlutter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flutter" />

        <!-- Grupo RadioButton -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Selecciona una modalidad:"
            android:textColor="#1D1B20"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgModalidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <RadioButton
                android:id="@+id/rbPresencial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Presencial" />

            <RadioButton
                android:id="@+id/rbOnline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online" />

            <RadioButton
                android:id="@+id/rbMixta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mixta" />
        </RadioGroup>

        <!-- Switch Notificaciones -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchNotificaciones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:checked="true"
            android:text="Notificaciones  " />

        <!-- Spinner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Selecciona un curso:"
            android:textColor="#1D1B20"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerCurso"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp" />

        <!-- SeekBar -->
        <TextView
            android:id="@+id/tvNivel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Nivel seleccionado: 50"
            android:textColor="#1D1B20"
            android:textSize="14sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekBarNivel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="50"
            android:progressTint="#6750A4"
            android:thumbTint="#6750A4" />

        <!-- Botones -->
        <Button
            android:id="@+id/btnGuardar1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#6750A4"
            android:text="Guardar información"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnGuardar2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#6750A4"
            android:text="Guardar información"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <!-- Resultado final -->
        <TextView
            android:id="@+id/tvResultado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:text="Aquí aparecerá el resultado."
            android:textColor="#49454F"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>